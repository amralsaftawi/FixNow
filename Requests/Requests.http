@baseUrl = http://localhost:5223

### 1. Register a new user
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Omar",
  "lastName": "Hassan",
  "email": "omar.hassan@example.com",
  "phoneNumber": "+201155500001",
  "password": "Omar@123456",
  "confirmPassword": "Omar@123456",
  "countryCode": "EG",
  "preferredLanguage": "English"
}

### 2. Login with the registered user
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "omar.hassan@example.com",
  "password": "Omar@123456"
}

###

@accessToken =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VEPjABh_O0o-tjjML3wTxfvPTQKLIUvOpTx-19qYPiE

### 3. Get the current user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}

### 4. Update the current user
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Omar",
  "lastName": "Hassan",
  "email": "omar.hassan@example.com",
  "phoneNumber": "+201155500001",
  "countryCode": "EG",
  "preferredLanguage": "English"
}

### 5. Change the password
POST {{baseUrl}}/api/users/me/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "Omar@123456",
  "newPassword": "Omar@654321",
  "confirmPassword": "Omar@654321"
}

### 6. Deactivate the current user
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}
